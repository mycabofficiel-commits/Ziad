# Configuration API Claude
ANTHROPIC_API_KEY=votre_cle_api_claude_ici

# Configuration Base de données (Railway fournira automatiquement DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:port/database

# Configuration Serveur
PORT=3000
NODE_ENV=production

# Secret pour JWT (générez une chaîne aléatoire sécurisée)
JWT_SECRET=changez_moi_par_une_chaine_aleatoire_securisee

# Configuration Frontend (URL de votre app une fois déployée)
FRONTEND_URL=http://localhost:3000
